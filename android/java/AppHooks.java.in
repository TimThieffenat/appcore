// Base template (appcore/android/java/): build_apk.sh fills in the Java package
// and the app's name (app_info.py) and puts it in its package's folder.
// Only used if the app does not have its own AppHooks.java (the app's
// android/java/, in its Java package): this one does nothing.
package @JAVA_PACKAGE@;

import android.app.Activity;

/**
 * The app's hooks into the main activity (the base's KeepAwakeActivity).
 * An app with Java of its own (in-app purchase, notifications…) writes its
 * own AppHooks.java in android/java/<its package>/ with these four methods.
 * The bridge with Python (Bridge) is already started before onCreate/onResume.
 * Errors are caught by the activity.
 */
final class AppHooks {
    private AppHooks() {
    }

    /** Right after the activity is created (Python starts afterwards). */
    static void onCreate(Activity activity) {
    }

    /** Each time the app comes back to the foreground. */
    static void onResume(Activity activity) {
    }

    /**
     * A request from Python (appcore.bridge.request) that the base does not
     * handle: return true if the app did.
     */
    static boolean onCommand(Activity activity, String command) {
        return false;
    }

    /** The user's answer to a permission request. */
    static void onRequestPermissionsResult(Activity activity, int requestCode,
                                           String[] permissions, int[] grantResults) {
    }
}
