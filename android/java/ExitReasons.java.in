// Base template (appcore/android/java/): build_apk.sh fills in the Java package
// and the app's name (app_info.py) and puts it in its package's folder.
package @JAVA_PACKAGE@;

import android.annotation.TargetApi;
import android.app.ActivityManager;
import android.app.ApplicationExitInfo;
import android.content.Context;
import android.content.SharedPreferences;
import android.os.Build;
import android.util.Log;

import java.io.File;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.io.OutputStreamWriter;
import java.io.Writer;
import java.nio.charset.StandardCharsets;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;
import java.util.Locale;

/**
 * Why the app stopped the last times, according to Android (11 and later).
 *
 * A crash in Qt or in Java, or an "app isn't responding",
 * closes the app before Python can note anything. Android, however, keeps the reason
 * for each exit (ApplicationExitInfo). At start-up, before Python, the
 * new exits are written to files/logs/exit_reasons.txt, and the trace of a
 * native crash or an ANR to files/logs/exit_&lt;date&gt;.trace.
 * crash_report.py reads them, puts them in the error report and, if it was a
 * crash, says so on screen.
 *
 * Format, one block per exit (most recent first):
 *   === 2026-10-19 14:02:11 · crash (native) · signal 11
 *   reason=5 importance=100 status=11 trace=exit_1760875331000.trace
 *   description: …
 *   memory: PSS 182 MB, RSS 240 MB
 *
 * Nothing is sent anywhere. No permission is needed.
 */
final class ExitReasons {
    private static final String TAG = "@APP_NAME@";
    private static final String FILE = "exit_reasons.txt";
    private static final String PREFS = "@APP_SLUG@_exit_reasons";
    private static final String LAST = "last_timestamp";
    private static final int MAX_RECORDS = 5;
    private static final int MAX_TRACE_BYTES = 512 * 1024;
    private static final int REASON_CRASH_NATIVE = 5;   // ApplicationExitInfo.REASON_CRASH_NATIVE
    private static final int REASON_ANR = 6;            // ApplicationExitInfo.REASON_ANR
    private static final int REASON_SIGNALED = 2;       // ApplicationExitInfo.REASON_SIGNALED

    private ExitReasons() {
    }

    /** Call at start-up, before Python. Never throws. */
    static void save(Context context) {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {
            return;   // ApplicationExitInfo: Android 11 (API 30) and later
        }
        try {
            write(context);
        } catch (Throwable error) {   // one report less, never an app that does not start
            Log.w(TAG, "exit reasons not saved: " + error);
        }
    }

    @TargetApi(Build.VERSION_CODES.R)
    private static void write(Context context) throws IOException {
        ActivityManager manager = (ActivityManager) context.getSystemService(Context.ACTIVITY_SERVICE);
        if (manager == null) {
            return;
        }
        List<ApplicationExitInfo> exits =
                manager.getHistoricalProcessExitReasons(context.getPackageName(), 0, MAX_RECORDS);
        SharedPreferences prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
        boolean firstRun = !prefs.contains(LAST);
        long last = prefs.getLong(LAST, 0L);
        long newest = last;
        for (ApplicationExitInfo exit : exits) {
            newest = Math.max(newest, exit.getTimestamp());
        }
        prefs.edit().putLong(LAST, newest).apply();
        if (firstRun) {
            return;   // first launch of this version: older exits do not count
        }
        File folder = new File(context.getFilesDir(), "logs");
        StringBuilder out = new StringBuilder();
        for (ApplicationExitInfo exit : exits) {   // most recent first
            if (exit.getTimestamp() > last) {
                describe(exit, folder, out);
            }
        }
        if (out.length() == 0) {
            return;
        }
        if (!folder.isDirectory() && !folder.mkdirs()) {
            return;
        }
        try (Writer writer = new OutputStreamWriter(
                new FileOutputStream(new File(folder, FILE)), StandardCharsets.UTF_8)) {
            writer.write(out.toString());
        }
    }

    @TargetApi(Build.VERSION_CODES.R)
    private static void describe(ApplicationExitInfo exit, File folder, StringBuilder out) {
        int reason = exit.getReason();
        SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US);
        out.append("=== ").append(format.format(new Date(exit.getTimestamp())))
                .append(" \u00b7 ").append(reasonName(reason));
        if (reason == REASON_CRASH_NATIVE || reason == REASON_SIGNALED) {
            out.append(" \u00b7 signal ").append(exit.getStatus());
        }
        out.append(" \u00b7 ").append(importanceName(exit.getImportance())).append('\n');
        out.append("reason=").append(reason)
                .append(" importance=").append(exit.getImportance())
                .append(" status=").append(exit.getStatus());
        String trace = saveTrace(exit, folder);
        if (trace != null) {
            out.append(" trace=").append(trace);
        }
        out.append('\n');
        String description = exit.getDescription();
        if (description != null && !description.isEmpty()) {
            out.append("description: ").append(description).append('\n');
        }
        out.append("memory: PSS ").append(exit.getPss() / 1024)
                .append(" MB, RSS ").append(exit.getRss() / 1024).append(" MB\n\n");
    }

    /** Trace of a native crash (tombstone, Android 12+) or an ANR (text). */
    @TargetApi(Build.VERSION_CODES.R)
    private static String saveTrace(ApplicationExitInfo exit, File folder) {
        int reason = exit.getReason();
        if (reason != REASON_CRASH_NATIVE && reason != REASON_ANR) {
            return null;
        }
        String name = "exit_" + exit.getTimestamp() + ".trace";
        try (InputStream in = exit.getTraceInputStream()) {
            if (in == null) {
                return null;
            }
            if (!folder.isDirectory() && !folder.mkdirs()) {
                return null;
            }
            try (OutputStream file = new FileOutputStream(new File(folder, name))) {
                byte[] buffer = new byte[16 * 1024];
                int total = 0;
                int count;
                while (total < MAX_TRACE_BYTES
                        && (count = in.read(buffer, 0, Math.min(buffer.length, MAX_TRACE_BYTES - total))) > 0) {
                    file.write(buffer, 0, count);
                    total += count;
                }
            }
            return name;
        } catch (IOException | RuntimeException error) {
            Log.w(TAG, "exit trace not saved: " + error);
            return null;
        }
    }

    private static String reasonName(int reason) {
        switch (reason) {
            case 1: return "exit self";
            case 2: return "signaled";
            case 3: return "low memory";
            case 4: return "crash (Java)";
            case 5: return "crash (native)";
            case 6: return "ANR (not responding)";
            case 7: return "initialization failure";
            case 8: return "permission change";
            case 9: return "excessive resource usage";
            case 10: return "user requested";
            case 11: return "user stopped";
            case 12: return "dependency died";
            case 13: return "other";
            case 14: return "freezer";
            case 15: return "package state change";
            case 16: return "package updated";
            default: return "unknown (" + reason + ")";
        }
    }

    private static String importanceName(int importance) {
        if (importance <= 100) {
            return "on screen";
        }
        if (importance <= 200) {
            return "visible";
        }
        if (importance <= 300) {
            return "in the background (service)";
        }
        return "in the background";
    }
}
