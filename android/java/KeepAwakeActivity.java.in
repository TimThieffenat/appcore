// Modèle du socle (appcore/android/java/) : build_apk.sh y met le paquet Java,
// le nom de l'app (app_info.py) et le range dans le dossier de son paquet.
package @JAVA_PACKAGE@;

import android.content.Intent;
import android.os.Bundle;
import android.util.Log;
import android.view.WindowManager;

import java.lang.reflect.Method;

import org.kivy.android.PythonActivity;

/**
 * Activité principale de l'app : celle de python-for-android (Qt), plus trois
 * choses :
 *
 * - l'écran reste allumé tant que l'app est affichée, comme pendant une vidéo.
 *   Android l'éteint normalement dès qu'on passe à une autre app ou qu'on la
 *   met en arrière-plan (le réglage ne vaut que pour cette fenêtre, il ne
 *   demande aucune autorisation et ne consomme rien quand l'app est cachée) ;
 * - avant de lancer Python, les causes des derniers arrêts de l'app
 *   (plantage, « ne répond pas »…) sont notées pour le rapport d'erreur
 *   (voir ExitReasons et crash_report.py) ;
 * - les crochets de l'app (AppHooks, dans son android/java/ : achat dans l'app,
 *   notifications…) à la création, au retour au premier plan et à la réponse
 *   d'une demande d'autorisation ; toujours protégés par try/catch : une erreur
 *   de l'app ne doit jamais empêcher l'activité de démarrer ;
 * - le résultat du sélecteur de fichiers d'Android est transmis à Qt.
 *   L'activité de python-for-android (PythonActivity.onActivityResult)
 *   l'intercepte sans appeler celle de Qt : QFileDialog n'apprenait jamais
 *   quel fichier avait été choisi. Le sélecteur créait le fichier, vide, et
 *   l'app attendait pour toujours (gel avec exec(), rien du tout avec open()).
 */
public class KeepAwakeActivity extends PythonActivity {
    private static final String TAG = "@APP_NAME@";
    private static Method qtActivityResult;   // QtNative.onActivityResult (privé au paquet de Qt)
    private static boolean qtLookupDone = false;

    @Override
    public void onCreate(Bundle savedInstanceState) {
        ExitReasons.save(this);   // avant super.onCreate : Python lit le fichier au démarrage
        super.onCreate(savedInstanceState);
        getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
        try {
            AppHooks.onCreate(this);
        } catch (Throwable error) {
            Log.w(TAG, "app hooks (create) failed: " + error);
        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        try {
            AppHooks.onResume(this);
        } catch (Throwable error) {
            Log.w(TAG, "app hooks (resume) failed: " + error);
        }
    }

    @Override
    public void onRequestPermissionsResult(int requestCode, String[] permissions,
                                           int[] grantResults) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
        try {
            AppHooks.onRequestPermissionsResult(this, requestCode, permissions, grantResults);
        } catch (Throwable error) {
            Log.w(TAG, "app hooks (permissions) failed: " + error);
        }
    }

    @Override
    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);   // écouteurs de python-for-android
        forwardToQt(requestCode, resultCode, data);
    }

    /** Ce que fait QtActivityBase.onActivityResult, que PythonActivity n'appelle pas. */
    private static void forwardToQt(int requestCode, int resultCode, Intent data) {
        try {
            if (!qtLookupDone) {
                qtLookupDone = true;
                Class<?> qtNative = Class.forName("org.qtproject.qt.android.QtNative");
                Method method = qtNative.getDeclaredMethod("onActivityResult",
                        int.class, int.class, Intent.class);
                method.setAccessible(true);
                qtActivityResult = method;
            }
            if (qtActivityResult != null) {
                qtActivityResult.invoke(null, requestCode, resultCode, data);
            } else {
                Log.w(TAG, "activity result not forwarded to Qt (method not found)");
            }
        } catch (Throwable error) {   // ne jamais faire planter l'app pour ça
            Log.w(TAG, "activity result not forwarded to Qt", error);
        }
    }
}
