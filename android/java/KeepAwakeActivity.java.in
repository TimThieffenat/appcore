// Base template (appcore/android/java/): build_apk.sh fills in the Java package
// and the app's name (app_info.py) and puts it in its package's folder.
package @JAVA_PACKAGE@;

import android.content.Intent;
import android.os.Bundle;
import android.util.Log;
import android.view.WindowManager;

import java.lang.reflect.Method;

import org.kivy.android.PythonActivity;

/**
 * The app's main activity: python-for-android's (Qt), plus a few
 * things:
 *
 * - the screen stays on while the app is shown, as during a video.
 *   Android turns it off as usual as soon as you switch to another app or
 *   put it in the background (the setting only applies to this window, it
 *   needs no permission and costs nothing when the app is hidden);
 * - before Python starts, the reasons for the app's last exits
 *   (crash, "not responding"…) are recorded for the error report
 *   (see ExitReasons and crash_report.py);
 * - the app's hooks (AppHooks, in its android/java/: in-app purchase,
 *   notifications…) at creation, when coming back to the foreground and on the
 *   answer to a permission request; always guarded by try/catch: an error
 *   in the app must never stop the activity from starting;
 * - the result of Android's file picker is passed on to Qt.
 *   python-for-android's activity (PythonActivity.onActivityResult)
 *   intercepts it without calling Qt's: QFileDialog never learned
 *   which file had been chosen. The picker created the file, empty, and
 *   the app waited forever (freeze with exec(), nothing at all with open()).
 */
public class KeepAwakeActivity extends PythonActivity {
    private static final String TAG = "@APP_NAME@";
    private static Method qtActivityResult;   // QtNative.onActivityResult (private to Qt's package)
    private static boolean qtLookupDone = false;

    @Override
    public void onCreate(Bundle savedInstanceState) {
        ExitReasons.save(this);   // before super.onCreate: Python reads the file at start-up
        super.onCreate(savedInstanceState);
        getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
        try {
            AppHooks.onCreate(this);
        } catch (Throwable error) {
            Log.w(TAG, "app hooks (create) failed: " + error);
        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        try {
            AppHooks.onResume(this);
        } catch (Throwable error) {
            Log.w(TAG, "app hooks (resume) failed: " + error);
        }
    }

    @Override
    public void onRequestPermissionsResult(int requestCode, String[] permissions,
                                           int[] grantResults) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
        try {
            AppHooks.onRequestPermissionsResult(this, requestCode, permissions, grantResults);
        } catch (Throwable error) {
            Log.w(TAG, "app hooks (permissions) failed: " + error);
        }
    }

    @Override
    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);   // python-for-android's listeners
        forwardToQt(requestCode, resultCode, data);
    }

    /** What QtActivityBase.onActivityResult does, which PythonActivity does not call. */
    private static void forwardToQt(int requestCode, int resultCode, Intent data) {
        try {
            if (!qtLookupDone) {
                qtLookupDone = true;
                Class<?> qtNative = Class.forName("org.qtproject.qt.android.QtNative");
                Method method = qtNative.getDeclaredMethod("onActivityResult",
                        int.class, int.class, Intent.class);
                method.setAccessible(true);
                qtActivityResult = method;
            }
            if (qtActivityResult != null) {
                qtActivityResult.invoke(null, requestCode, resultCode, data);
            } else {
                Log.w(TAG, "activity result not forwarded to Qt (method not found)");
            }
        } catch (Throwable error) {   // never crash the app for this
            Log.w(TAG, "activity result not forwarded to Qt", error);
        }
    }
}
