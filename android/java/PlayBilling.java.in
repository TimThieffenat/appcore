// Base template (appcore/android/java/): build_apk.sh fills in the Java package
// and the product ID (PRO_PRODUCT of app_info.py); only built for an app with
// a Pro version. Needs Google Play Billing (added by build_apk.sh).

package @JAVA_PACKAGE@;

import android.app.Activity;
import android.util.Log;

import com.android.billingclient.api.AcknowledgePurchaseParams;
import com.android.billingclient.api.AcknowledgePurchaseResponseListener;
import com.android.billingclient.api.BillingClient;
import com.android.billingclient.api.BillingClientStateListener;
import com.android.billingclient.api.BillingFlowParams;
import com.android.billingclient.api.BillingResult;
import com.android.billingclient.api.PendingPurchasesParams;
import com.android.billingclient.api.ProductDetails;
import com.android.billingclient.api.ProductDetailsResponseListener;
import com.android.billingclient.api.Purchase;
import com.android.billingclient.api.PurchasesResponseListener;
import com.android.billingclient.api.PurchasesUpdatedListener;
import com.android.billingclient.api.QueryProductDetailsParams;
import com.android.billingclient.api.QueryProductDetailsResult;
import com.android.billingclient.api.QueryPurchasesParams;

import org.json.JSONException;
import org.json.JSONObject;

import java.util.Collections;
import java.util.List;

/**
 * One-time purchase of the Pro version with Google Play Billing (library 8).
 *
 * The product (PRO_PRODUCT of app_info.py, a one-time, non-consumable product)
 * is created in the Play Console. At start-up and every time the app comes
 * back, purchases are read again from Google Play (so a refund removes Pro);
 * the result goes to state.json, section "billing":
 *   available : Google Play answers;
 *   pro       : true / false, or missing if it could not be known (Python
 *               then keeps what it knew);
 *   pending   : purchase waiting (cash payment, for example);
 *   price     : the price shown by Google Play ("€4.99");
 *   message   : the last thing to say (purchase cancelled, error…), in English.
 */
final class PlayBilling implements PurchasesUpdatedListener {
    static final String PRODUCT = "@PRO_PRODUCT@";
    private static PlayBilling instance;

    private final BillingClient client;
    private Activity activity;
    private ProductDetails details;
    private boolean ready;
    private boolean available;
    private Boolean pro;          // null: not known yet
    private boolean pending;
    private String price = "";
    private String message = "";

    private PlayBilling(Activity current) {
        activity = current;
        client = BillingClient.newBuilder(current.getApplicationContext())
                .setListener(this)
                .enablePendingPurchases(PendingPurchasesParams.newBuilder()
                        .enableOneTimeProducts()
                        .build())
                .enableAutoServiceReconnection()
                .build();
    }

    static void start(Activity current) {
        if (instance == null) {
            instance = new PlayBilling(current);
            instance.connect();
        }
        instance.activity = current;
    }

    static void refresh() {
        if (instance != null && instance.ready) {
            instance.queryProduct();
            instance.queryPurchases();
        } else if (instance != null) {
            instance.connect();
        }
    }

    static void buy(Activity current) {
        if (instance == null) {
            start(current);
        }
        instance.activity = current;
        instance.launch();
    }

    private void connect() {
        client.startConnection(new BillingClientStateListener() {
            @Override
            public void onBillingSetupFinished(BillingResult result) {
                ready = result.getResponseCode() == BillingClient.BillingResponseCode.OK;
                available = ready;
                if (ready) {
                    queryProduct();
                    queryPurchases();
                } else {
                    message = "Google Play is not available (" + result.getResponseCode() + ")";
                    report();
                }
            }

            @Override
            public void onBillingServiceDisconnected() {
                ready = false;   // automatic reconnection (enableAutoServiceReconnection)
            }
        });
    }

    private void queryProduct() {
        QueryProductDetailsParams params = QueryProductDetailsParams.newBuilder()
                .setProductList(Collections.singletonList(
                        QueryProductDetailsParams.Product.newBuilder()
                                .setProductId(PRODUCT)
                                .setProductType(BillingClient.ProductType.INAPP)
                                .build()))
                .build();
        client.queryProductDetailsAsync(params, new ProductDetailsResponseListener() {
            @Override
            public void onProductDetailsResponse(BillingResult result,
                                                 QueryProductDetailsResult found) {
                if (result.getResponseCode() == BillingClient.BillingResponseCode.OK
                        && found != null && !found.getProductDetailsList().isEmpty()) {
                    details = found.getProductDetailsList().get(0);
                    ProductDetails.OneTimePurchaseOfferDetails offer =
                            details.getOneTimePurchaseOfferDetails();
                    if (offer != null) {
                        price = offer.getFormattedPrice();
                    }
                } else {
                    message = "Product \"" + PRODUCT + "\" not found (" + result.getResponseCode()
                            + "): create it in the Play Console";
                }
                report();
            }
        });
    }

    private void queryPurchases() {
        QueryPurchasesParams params = QueryPurchasesParams.newBuilder()
                .setProductType(BillingClient.ProductType.INAPP)
                .build();
        client.queryPurchasesAsync(params, new PurchasesResponseListener() {
            @Override
            public void onQueryPurchasesResponse(BillingResult result, List<Purchase> purchases) {
                if (result.getResponseCode() != BillingClient.BillingResponseCode.OK) {
                    return;   // not known: nothing changes
                }
                boolean owned = false;
                boolean waiting = false;
                for (Purchase purchase : purchases) {
                    if (!purchase.getProducts().contains(PRODUCT)) {
                        continue;
                    }
                    if (purchase.getPurchaseState() == Purchase.PurchaseState.PURCHASED) {
                        owned = true;
                        acknowledge(purchase);
                    } else if (purchase.getPurchaseState() == Purchase.PurchaseState.PENDING) {
                        waiting = true;
                    }
                }
                pro = owned;
                pending = waiting && !owned;
                report();
            }
        });
    }

    private void launch() {
        if (!ready || details == null) {
            message = ready ? "Product not loaded yet" : "Google Play is not available";
            report();
            refresh();
            return;
        }
        BillingFlowParams params = BillingFlowParams.newBuilder()
                .setProductDetailsParamsList(Collections.singletonList(
                        BillingFlowParams.ProductDetailsParams.newBuilder()
                                .setProductDetails(details)
                                .build()))
                .build();
        BillingResult result = client.launchBillingFlow(activity, params);
        if (result.getResponseCode() != BillingClient.BillingResponseCode.OK) {
            message = "Purchase could not start (" + result.getResponseCode() + ")";
            report();
        }
    }

    @Override
    public void onPurchasesUpdated(BillingResult result, List<Purchase> purchases) {
        int code = result.getResponseCode();
        if (code == BillingClient.BillingResponseCode.OK && purchases != null) {
            message = "";
            queryPurchases();   // reads everything again: pro, pending, acknowledgement
        } else if (code == BillingClient.BillingResponseCode.USER_CANCELED) {
            message = "cancelled";
            report();
        } else if (code == BillingClient.BillingResponseCode.ITEM_ALREADY_OWNED) {
            queryPurchases();
        } else {
            message = "Purchase failed (" + code + ")";
            report();
        }
    }

    /** Without an acknowledgement within 3 days, Google Play refunds the purchase. */
    private void acknowledge(Purchase purchase) {
        if (purchase.isAcknowledged()) {
            return;
        }
        AcknowledgePurchaseParams params = AcknowledgePurchaseParams.newBuilder()
                .setPurchaseToken(purchase.getPurchaseToken())
                .build();
        client.acknowledgePurchase(params, new AcknowledgePurchaseResponseListener() {
            @Override
            public void onAcknowledgePurchaseResponse(BillingResult result) {
                Log.i(Bridge.TAG, "purchase acknowledged: " + result.getResponseCode());
            }
        });
    }

    private void report() {
        JSONObject out = new JSONObject();
        try {
            out.put("available", available);
            if (pro != null) {
                out.put("pro", pro.booleanValue());
            }
            out.put("pending", pending);
            out.put("price", price);
            out.put("message", message);
        } catch (JSONException error) {
            return;
        }
        Bridge.put("billing", out);
    }
}
